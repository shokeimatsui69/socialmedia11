# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APIFY_API_KEY="MY_APIFY_API_KEY"
# Bulk Like / Bulk Comment also support APIFY_TOKEN. Keep real tokens out of the repo.
APIFY_TOKEN="MY_APIFY_TOKEN"
APIFY_BASE_URL="https://api.apify.com"
APIFY_WAIT_FOR_FINISH="0"
APIFY_TIMEOUT_MS="120000"
OPENAI_API_KEY="MY_OPENAI_API_KEY"
XAI_API_KEY="MY_XAI_API_KEY"

OPENAI_MODEL="gpt-5.5"
XAI_MODEL="grok-4.3"

APIFY_INSTAGRAM_POST_ACTOR_ID="apify/instagram-post-scraper"
APIFY_INSTAGRAM_LIKE_ACTOR_ID="WxPRaG9gfg5KZ4gY1"
APIFY_INSTAGRAM_COMMENT_ACTOR_ID="SbK00X0JYCPblD2wp"
BULK_LIKE_APIFY_ACTOR_ID="dead00/instagram-like-bot"
BULK_COMMENT_APIFY_ACTOR_ID="dead00/insta-comment-bot"
APIFY_SYNC_TIMEOUT_SECONDS="180"
APIFY_ACTOR_TIMEOUT_SECS="1800"
COMPETITOR_POST_LIMIT="3"
COMPETITOR_COMMENT_LIMIT="20"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
